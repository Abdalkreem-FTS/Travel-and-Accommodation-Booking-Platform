# Copy to .env before the first `docker compose up -d`

MSSQL_SA_PASSWORD=Abdalkreem_Bzoor_123!

# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Signs payment-provider events sent to POST /api/payment-events. Generate one with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# Fake (default) needs nothing else. Stripe needs a test-mode key and the whsec_ secret that
# `stripe listen --forward-to localhost:8080/api/payment-events` prints; live keys are refused.
PAYMENT_PROVIDER=Fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development only: an admin account created on startup (register + Admin role), so the admin
# pages work on a fresh stack. Leave either blank to seed none. The password needs 12+ characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
