{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "OTEL_SERVICE_NAME": "hotelbooking-gateway",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",
  "Gateway": {
    "ExposeUpstream": false
  },
  "RateLimits": {
    "Enabled": true,
    "Auth": { "Permit": 10, "WindowMinutes": 15 },
    "Global": { "Permit": 300, "WindowMinutes": 1 }
  },
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "api",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/sessions", "Methods": [ "POST" ] }
      },
      "register": {
        "ClusterId": "api",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/users", "Methods": [ "POST" ] }
      },
      "payment-events": {
        "ClusterId": "api",
        "RateLimiterPolicy": "Disable",
        "Match": { "Path": "/api/payment-events", "Methods": [ "POST" ] }
      },
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "openapi": {
        "ClusterId": "api",
        "Match": { "Path": "/openapi/{**catch-all}" }
      },
      "scalar": {
        "ClusterId": "api",
        "Match": { "Path": "/scalar/{**catch-all}" }
      },
      "health-ready": {
        "ClusterId": "api",
        "Match": { "Path": "/health/ready" }
      },
      "web": {
        "ClusterId": "web",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "LoadBalancingPolicy": "LeastRequests",
        "SessionAffinity": { "Enabled": false },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:35"
        }
      },
      "web": {}
    }
  }
}
